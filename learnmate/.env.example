# Copy this file to .env.local (git-ignored) and fill in the values.
# Both are read only by the Vite dev server (vite.config.js), never by browser code.

# Printed by the last cell of the Kaggle notebook, e.g. https://xxxx.ngrok-free.dev
LEARNMATE_API_URL=

# Must equal the LEARNMATE_API_KEY Kaggle secret (or the temporary key the notebook printed).
LEARNMATE_API_KEY=
